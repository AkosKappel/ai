{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "observability": { "enabled": true },
  // Served only on its own domain; Cloudflare creates the DNS record and certificate on deploy.
  "routes": [{ "pattern": "ai.akoskappel.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  // At most 5 chat messages a minute per visitor IP. The namespace ID is any number unique to
  // this account.
  "ratelimits": [
    { "name": "CHAT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "KNOWLEDGE_URL": "https://akoskappel.dev/llms-full.txt",
    "ALLOWED_ORIGINS": "https://akoskappel.dev,http://localhost:3000"
  }
}
