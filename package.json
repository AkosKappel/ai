{
  "name": "portfolio-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types --env-file .dev.vars.example",
    "lint": "biome check",
    "check": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=3",
    "eval": "tsx evals/run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  }
}
